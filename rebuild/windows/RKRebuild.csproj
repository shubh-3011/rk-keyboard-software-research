<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>RK-Rebuild</AssemblyName>
    <RootNamespace>RkRebuild</RootNamespace>
    <Version>0.6.3</Version>
    <AssemblyVersion>0.6.3.0</AssemblyVersion>
    <FileVersion>0.6.3.0</FileVersion>
    <InformationalVersion>0.6.3-verified-mode-feedback-preview</InformationalVersion>
    <Company>Independent community project</Company>
    <Product>RK Rebuild</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove="installer\**\*.cs" />
    <EmbeddedResource Include="..\..\models-4.6.json" LogicalName="RkRebuild.Profiles.json" />
    <EmbeddedResource Include="..\..\rk-drive-catalog.json" LogicalName="RkRebuild.DriveCatalog.json" />
    <EmbeddedResource Include="..\..\s98-appearance.json" LogicalName="RkRebuild.S98Appearance.json" />
  </ItemGroup>
</Project>
