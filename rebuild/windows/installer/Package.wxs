<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- Keep UpgradeCode and component GUIDs stable across releases. No vendor assets. -->
  <Package Name="RK Rebuild (experimental)" Manufacturer="Independent community project"
           Version="$(PackageVersion)" ProductCode="$(ProductCode)"
           UpgradeCode="12D50DE5-7286-4B6E-99D9-B4F9FC1F7996"
           Language="1033" Scope="perUser" InstallerVersion="500" Compressed="yes">
    <SummaryInformation Description="Unsigned experimental RK Rebuild per-user installer" />
    <MajorUpgrade AllowDowngrades="no" AllowSameVersionUpgrades="no"
                  DowngradeErrorMessage="A newer version of RK Rebuild is already installed for this user."
                  Schedule="afterInstallInitialize" />
    <Launch Condition="NOT ALLUSERS" Message="RK Rebuild supports per-user installation only. Do not set ALLUSERS." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="UserProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="RK Rebuild">
          <Component Id="ApplicationFiles" Guid="6A9694FA-23E2-49E1-9D3A-38602B15AC56">
            <!-- An explicit allowlist, not harvesting: no vendor files or .research. -->
            <File Id="AppExecutable" Source="$(SourceExe)" Name="RK-Rebuild.exe" />
            <File Id="ProjectLicense" Source="$(LicenseFile)" Name="LICENSE.txt" />
            <RegistryValue Root="HKCU" Key="Software\RK Rebuild\Installer" Name="Application"
                           Type="integer" Value="1" KeyPath="yes" />
            <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
            <RemoveFolder Id="RemoveEmptyProgramsFolder" Directory="UserProgramsFolder" On="uninstall" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationMenuFolder" Name="RK Rebuild">
        <Component Id="StartMenuShortcut" Guid="2FE6B5AE-A1B9-42AA-A2C1-325A59FB1B16">
          <Shortcut Id="ApplicationShortcut" Name="RK Rebuild" Description="RK Rebuild (experimental)"
                    Target="[INSTALLFOLDER]RK-Rebuild.exe" WorkingDirectory="INSTALLFOLDER" Advertise="no" />
          <RegistryValue Root="HKCU" Key="Software\RK Rebuild\Installer" Name="StartMenuShortcut"
                         Type="integer" Value="1" KeyPath="yes" />
          <RemoveFolder Id="RemoveMenuFolder" On="uninstall" />
        </Component>
      </Directory>
    </StandardDirectory>
    <Feature Id="Main" Title="RK Rebuild" Level="1">
      <ComponentRef Id="ApplicationFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>
</Wix>
